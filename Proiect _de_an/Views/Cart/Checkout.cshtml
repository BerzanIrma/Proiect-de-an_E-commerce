@model Proiect__de_an.Models.CartViewModel
@{
    ViewData["Title"] = "Finalizare comandă";
    var displayTotal = Model.FinalTotal > 0 ? Model.FinalTotal : Model.Total;
}

<section class="py-5">
  <div class="container">
    <h1 class="mb-4">Finalizare comandă</h1>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title mb-3">Detalii livrare</h5>
            <p class="mb-1"><strong>Tip livrare:</strong> @(Model.DeliveryType == "Express" ? "Express (1–2 zile lucrătoare)" : "Standard (3–5 zile lucrătoare)")</p>
            <p class="mb-3 text-muted small">Cost livrare: @Model.DeliveryCost.ToString("C")</p>
            <hr />

            <h6 class="mb-2">Opțiuni</h6>
            <form method="post" asp-action="Checkout" class="mb-4">
              @Html.AntiForgeryToken()
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="giftWrap" id="giftWrap" value="true" @(Model.GiftWrapRequested ? "checked" : "")>
                <label class="form-check-label" for="giftWrap">Ambalaj cadou (+@Model.GiftWrapFee.ToString("C"))</label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="applyDiscount" id="applyDiscount" value="true" @(Model.DiscountApplied ? "checked" : "")>
                <label class="form-check-label" for="applyDiscount">Reducere @(Model.DisplayDiscountPercent)% (plicabilă pe site)</label>
              </div>
              <hr />
              <h6 class="mb-2">Metodă de plată </h6>
              <div class="form-check mb-1">
                <input class="form-check-input" type="radio" name="paymentMethod" id="payCard" value="Card" checked />
                <label class="form-check-label" for="payCard">Card online</label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="paymentMethod" id="payPayPal" value="PayPal" />
                <label class="form-check-label" for="payPayPal">PayPal</label>
              </div>
              <button type="submit" class="btn btn-outline-primary btn-sm">Actualizează total</button>
            </form>

            <hr />
            <h6 class="mb-2">Produse</h6>
            <ul class="list-unstyled mb-3">
              @foreach (var item in Model.Items)
              {
                <li class="d-flex justify-content-between py-1">
                  <span>@item.Name × @item.Quantity</span>
                  <span>@item.LineTotal.ToString("C")</span>
                </li>
              }
            </ul>
            <p class="d-flex justify-content-between mb-1"><span>Subtotal</span> <span>@Model.Subtotal.ToString("C")</span></p>
            <p class="d-flex justify-content-between mb-1"><span>Livrare</span> <span>@Model.DeliveryCost.ToString("C")</span></p>
            @if (Model.GiftWrapRequested)
            {
              <p class="d-flex justify-content-between mb-1 text-success"><span>Ambalaj cadou</span> <span>+@Model.GiftWrapFee.ToString("C")</span></p>
            }
            @if (Model.DiscountApplied)
            {
              <p class="d-flex justify-content-between mb-1 text-success"><span>Reducere @(Model.DisplayDiscountPercent)%</span> <span>—</span></p>
            }
            <p class="d-flex justify-content-between fw-bold fs-5 mt-2"><span>Total</span> <span>@displayTotal.ToString("C")</span></p>
            <div class="alert alert-success mt-3 mb-0" role="status">
              Comanda ta a fost înregistrată (demo). Livrare: <strong>@Model.DeliveryType</strong>.
              @if (Model.GiftWrapRequested) { <span> | Ambalaj cadou inclus.</span> }
              @if (Model.DiscountApplied) { <span> | Reducere @(Model.DisplayDiscountPercent)% aplicată.</span> }
              @if (ViewBag.PaymentMessage != null)
              {
                <span> | @ViewBag.PaymentMessage</span>
              }
            </div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-3">Înapoi la start</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
